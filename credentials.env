# Lab credentials for the attack-sim. CONTROLLED DUMMY LAB — throwaway lab creds,
# committed directly so a fresh clone is plug-and-play. Env vars override this
# file; passwords are redacted (***) from all evidence. Do NOT put a real-world
# secret here while this file is tracked.
#
# DC / AD creds (dcsync/psexec/wmiexec/nopac/sama/... + ssh_brute fallback):
HARNESS_DOMAIN=lab.local
HARNESS_DC_USER=Administrator
HARNESS_DC_PASS=NewPass123!
#
# SSH creds (ssh_brute). This lab's SSH target is the SAME Windows identity as the
# DC, so these are set to the same login as HARNESS_DC_* above ('administrator' ==
# the DC 'Administrator' — Windows usernames are case-insensitive). ssh_brute uses
# these; a per-target value in .target_memory.json overrides them, and leaving them
# blank falls back to HARNESS_DC_USER / HARNESS_DC_PASS.
HARNESS_SSH_USER=administrator
HARNESS_SSH_PASS=NewPass123!
