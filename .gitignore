# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Runtime attack evidence (created at run time; may contain captured hashes)
evidence/

# Local secrets / target scope / operator infra — never commit these
credentials.env
allowlist.txt
config.json
detections.json
.env

# OS / editor
desktop.ini
.DS_Store
Thumbs.db
.idea/
.vscode/

# Terraform (cloud deploy) — state may hold secrets; tfvars holds infra IPs
deploy/cloud/**/.terraform/
deploy/cloud/**/*.tfstate
deploy/cloud/**/*.tfstate.*
deploy/cloud/**/terraform.tfvars
deploy/cloud/**/.terraform.lock.hcl

# Fleet of targets (operator-specific infra / IPs)
fleet.json

# Per-target remembered options (source/cloud ports) — operator-specific
.target_memory.json

# Generated lab TLS cert for the https-lab container (never commit keys)
deploy/nginx/certs/
