# Copy to terraform.tfvars and fill in. terraform.tfvars is git-ignored.
prefix         = "ussdc"
location       = "southeastasia"

# REQUIRED — the ONLY source IPs allowed to reach the vulnerable DC.
# Use your tester / NOC egress IP(s). NEVER 0.0.0.0/0.
tester_cidrs   = ["203.0.113.10/32", "198.51.100.0/28"]

admin_username = "azadmin"
